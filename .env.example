# Tangent environment (copy to .env; .env is gitignored). NO REAL KEYS IN GIT.

# TMDB (movies + TV): https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB (games): https://api-docs.igdb.com/ (Twitch app credentials)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Open Library (books): no key required
# CheapShark (game deals): no key required

# Supabase (Postgres + pgvector + auth): https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only (never ship to the frontend):
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# App
APP_ENV=dev
