# Tangent backend env. Copy to backend/.env (gitignored). NO REAL KEYS IN GIT.
# The API reads this file when it runs from the backend/ folder.

# TMDB (movies + TV): https://www.themoviedb.org/settings/api  (API Key, v3 auth)
TMDB_API_KEY=

# IGDB (games): https://dev.twitch.tv/console -> Register Your Application
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Open Library (books) and CheapShark (deals): no key required.

# Supabase (Phase 2+; Postgres + pgvector + auth): https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

APP_ENV=dev
